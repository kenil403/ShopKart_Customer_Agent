# =====================================================================
#  ShopKart Support Agent — settings
#  1) Copy this file to  backend/.env   (same folder as run.py)
#  2) Paste your keys (no quotes, no spaces around =)
#  3) Restart the backend after every change
#  4) Test with:  uv run python -m scripts.check_llm
# =====================================================================

# ---- API keys (free tiers work) -----------------------------------------
GROQ_API_KEY=paste-your-groq-key-here          # https://console.groq.com/keys
GOOGLE_API_KEY=paste-your-gemini-key-here      # https://aistudio.google.com/apikey
MISTRAL_API_KEY=paste-your-mistral-key-here    # https://console.mistral.ai/api-keys

# ---- Models (format provider:model) ---------------------------------------
# The main model answers. If it is rate-limited or broken, the router switches to
# the next one automatically and comes back when the main model recovers.
LLM_MODEL=groq:openai/gpt-oss-120b
LLM_FALLBACKS=google_genai:gemini-3.1-flash-lite,mistralai:mistral-small-latest

# Free-tier limits (September 2026, per model):
#   groq:openai/gpt-oss-120b            30 req/min, 1,000 req/day, 8,000 tokens/min
#   google_genai:gemini-3.1-flash-lite  15 req/min, ~500 req/day
#   google_genai:gemini-2.5-flash       only 20 req/day  <- avoid on free tier
#   mistralai:mistral-small-latest      1 req/second
# Retired: groq:llama-3.3-70b-versatile (shut down 16 Aug 2026 -> 404 errors)
# See every model your key can use:  uv run python -m scripts.check_llm --list

# ---- Pacing (requests per second, stays under the limits above) -----------
GROQ_RPS=0.4
GEMINI_RPS=0.2
MISTRAL_RPS=0.8

# ---- Retrieval (optional) -------------------------------------------------
# Empty = keyword search (BM25) only. To add embeddings (uses extra quota):
#   EMBEDDING_MODEL=mistralai:mistral-embed
EMBEDDING_MODEL=
RETRIEVAL_TOP_K=3

# ---- Store date -------------------------------------------------------------
# Pins "today" so return windows match the sample orders and the eval.
# Delete this line to use the real date.
STORE_TODAY=2026-09-26

# ---- Evaluation ---------------------------------------------------------------
EVAL_DELAY_SECONDS=4        # pause between questions
EVAL_MAX_WAIT_SECONDS=180   # when all models are busy, wait up to this long, then retry
